{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"paths": {
			"#/*": ["./src/*"],
			"@/*": ["./src/*"]
		},
		"allowImportingTsExtensions": true
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "*.config.ts"]
}
