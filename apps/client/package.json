{
	"name": "@salary-manager/client",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build && tsc --noEmit",
		"preview": "vite preview",
		"typecheck": "pnpm run generate-routes && tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"generate-routes": "vite build --logLevel warn"
	},
	"dependencies": {
		"@salary-manager/common": "workspace:*",
		"@salary-manager/contracts": "workspace:*",
		"@salary-manager/ui": "workspace:*",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "latest",
		"@tanstack/react-query": "^5.104.0",
		"@tanstack/react-query-devtools": "^5.104.0",
		"@tanstack/react-router": "latest",
		"@tanstack/react-router-devtools": "latest",
		"@tanstack/react-start": "latest",
		"@ts-rest/core": "3.52.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "^4.1.18",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@tailwindcss/typography": "^0.5.16",
		"@tanstack/devtools-vite": "latest",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.3",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"jsdom": "^30.1.1",
		"typescript": "^7.0.2",
		"vite": "^8.0.0",
		"vitest": "^5.0.2"
	}
