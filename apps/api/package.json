{
	"name": "@salary-manager/api",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=../../.env --include '../../packages/*/src/**/*.ts' src/index.ts",
		"build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/index.cjs --sourcemap",
		"start": "node --env-file-if-exists=../../.env --enable-source-maps dist/index.cjs",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@salary-manager/contracts": "workspace:*",
		"@ts-rest/express": "3.52.1",
		"express": "^4.21.2",
		"@salary-manager/domain": "workspace:*"
	},
	"devDependencies": {
		"esbuild": "0.28.2",
		"@types/express": "^4.17.21",
		"tsx": "^4.23.15",
		"vitest": "^5.0.2"
	}
}
