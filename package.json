{
	"name": "salary-manager",
	"private": true,
	"version": "1.0.0",
	"description": "",
	"type": "module",
	"packageManager": "pnpm@11.15.1",
	"scripts": {
		"biome": "biome check .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write .",
		"dev:api": "pnpm --filter @salary-manager/api run dev",
		"dev": "pnpm --parallel --filter @salary-manager/api --filter @salary-manager/client run dev",
		"dev:client": "pnpm --filter @salary-manager/client run dev",
		"build": "pnpm -r run build",
		"typecheck": "pnpm -r run typecheck",
		"test": "pnpm -r run test",
		"check": "pnpm run biome && pnpm run typecheck && pnpm run test",
		"db:up": "docker compose up -d --wait db",
		"db:down": "docker compose down",
		"db:generate": "pnpm --filter @salary-manager/domain run db:generate",
		"db:migrate": "pnpm --filter @salary-manager/domain run db:migrate",
		"db:reset": "pnpm --filter @salary-manager/domain run db:reset",
		"db:seed": "pnpm --filter @salary-manager/domain run db:seed",
		"test:db": "pnpm --filter @salary-manager/domain run test:db"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/node": "^26.6.3",
		"typescript": "^7.0.2"
	}
}
